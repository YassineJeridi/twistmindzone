# MongoDB connection string
# Local MongoDB (default): mongodb://127.0.0.1:27017/mino-tracking
# MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mino-tracking
MONGODB_URI=mongodb://127.0.0.1:27017/mino-tracking

# Port the API server runs on
PORT=5001

# The passkey required to add/edit/delete videos or toggle paid status.
# Change this to something only you and the client know.
PASSKEY=change-me-please

# Long random string used to sign login sessions. Change to any random text.
JWT_SECRET=change-this-to-a-long-random-string

# Origin of the frontend app (for CORS). Adjust if you deploy elsewhere.
CLIENT_ORIGIN=http://localhost:5173
